# Copy to .env and edit. Loaded by systemd (EnvironmentFile) or `make run`.

# Ports
WEB_PORT=8080
MCP_PORT=9000

# Printer BLE MAC. Required on Linux/BlueZ — auto-discovery by name does not
# work (the printer puts its name only in active-scan responses, which the
# passive scanner never sees). Find it with: go run ./scripts/scan
PRINTER_ADDRESS=D1:01:04:14:52:B4

# SQLite job log path (absolute recommended under systemd).
DB_PATH=/home/andrew/projects/catprint/jobs.db
